# Copy this file to .env and fill in the values.
# NEVER commit the real .env file — it is listed in .gitignore.

# WhatsApp business number in international format, no + or spaces.
# Example: 919876543210  (represents +91 98765 43210)
# ⚠️ CONFIRM with the business owner before setting this value.
VITE_WHATSAPP_NUMBER=
